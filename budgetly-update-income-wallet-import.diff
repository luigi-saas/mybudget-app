+"use client";
+
+import { useState, FormEvent } from "react";
+import { useAuth } from "@/lib/auth-context";
+import { useBudgetData } from "@/lib/useBudgetData";
+import { addIncome, deleteIncome } from "@/lib/firestore";
+import type { Account } from "@/lib/types";
